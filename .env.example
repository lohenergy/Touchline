# Touchline environment configuration (example)
# Copy to .env and fill in values. Never commit .env.

# LLM provider: local | azure | github
TOUCHLINE_LLM_PROVIDER=local

# Azure OpenAI / Foundry AI Services
AZURE_OPENAI_ENDPOINT=https://your-resource.services.ai.azure.com
AZURE_OPENAI_API_KEY=your-key-here
AZURE_OPENAI_DEPLOYMENT=gpt-narrator
# Leave blank if using /openai/v1/chat/completions path
AZURE_OPENAI_API_VERSION=

# Request tuning
TOUCHLINE_LLM_TIMEOUT_S=30
TOUCHLINE_LLM_MAX_TOKENS=700
TOUCHLINE_LLM_TEMPERATURE=0.3

# GitHub Models (optional fallback)
GITHUB_MODELS_TOKEN=
GITHUB_MODELS_MODEL=openai/gpt-4o-mini
